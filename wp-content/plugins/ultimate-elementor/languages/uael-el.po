#: abilities/handlers/branding/class-uael-branding-get-handler.php:55
msgid "Get Branding Settings"
msgstr "Λάβετε ρυθμίσεις branding"

#: abilities/handlers/branding/class-uael-branding-get-handler.php:56
msgid "Retrieve current white-label branding settings including plugin name, author, and support URLs."
msgstr "Ανακτήστε τις τρέχουσες ρυθμίσεις branding λευκής ετικέτας, συμπεριλαμβανομένου του ονόματος του plugin, του συγγραφέα και των URL υποστήριξης."

#: abilities/handlers/branding/class-uael-branding-update-handler.php:71
msgid "Update Branding Settings"
msgstr "Ενημέρωση ρυθμίσεων branding"

#: abilities/handlers/branding/class-uael-branding-update-handler.php:72
msgid "Update white-label branding settings such as plugin name, author name, description, and support URLs."
msgstr "Ενημέρωση ρυθμίσεων branding λευκής ετικέτας όπως το όνομα του plugin, το όνομα του συγγραφέα, την περιγραφή και τα URL υποστήριξης."

#: abilities/handlers/branding/class-uael-branding-update-handler.php:79
msgid "JSON string of branding settings to update. Example: {\"plugin\":{\"name\":\"My Plugin\"},\"agency\":{\"author\":\"My Agency\"}}"
msgstr "JSON string ρυθμίσεων branding προς ενημέρωση. Παράδειγμα: {\"plugin\":{\"name\":\"My Plugin\"},\"agency\":{\"author\":\"My Agency\"}}"

#: abilities/handlers/branding/class-uael-branding-update-handler.php:131
msgid "No branding settings provided."
msgstr "Δεν παρέχονται ρυθμίσεις branding."

#: abilities/handlers/branding/class-uael-branding-update-handler.php:171
msgid "No valid branding settings provided."
msgstr "Δεν παρέχονται έγκυρες ρυθμίσεις branding."

#: abilities/handlers/branding/class-uael-branding-update-handler.php:185
msgid "Branding settings saved successfully."
msgstr "Οι ρυθμίσεις branding αποθηκεύτηκαν με επιτυχία."

#: abilities/handlers/builder/class-uael-add-column-handler.php:48
msgid "Add Column to Section"
msgstr "Προσθήκη Στήλης στην Ενότητα"

#: abilities/handlers/builder/class-uael-add-column-handler.php:49
msgid "Adds a column to an existing section or container in any Elementor post. Automatically redistributes column sizes to fit."
msgstr "Προσθέτει μια στήλη σε μια υπάρχουσα ενότητα ή δοχείο σε οποιαδήποτε δημοσίευση Elementor. Αυτόματα αναδιανέμει τα μεγέθη των στηλών για να ταιριάζουν."

#: abilities/handlers/builder/class-uael-add-column-handler.php:60
#: abilities/handlers/builder/class-uael-add-section-handler.php:59
#: abilities/handlers/builder/class-uael-build-handler.php:60
#: abilities/handlers/builder/class-uael-insert-widget-handler.php:59
#: abilities/handlers/builder/class-uael-move-element-handler.php:60
#: abilities/handlers/builder/class-uael-remove-element-handler.php:59
#: abilities/handlers/builder/class-uael-structure-handler.php:59
#: abilities/handlers/builder/class-uael-update-widget-handler.php:60
msgid "Any Elementor-enabled post ID (page, post, or template)."
msgstr "Οποιοδήποτε ID δημοσίευσης που υποστηρίζεται από Elementor (σελίδα, δημοσίευση ή πρότυπο)."

#: abilities/handlers/builder/class-uael-add-column-handler.php:64
msgid "Section or container element ID to add column to."
msgstr "ID στοιχείου ενότητας ή δοχείου για προσθήκη στήλης."

#: abilities/handlers/builder/class-uael-add-column-handler.php:69
msgid "If true, automatically redistributes all column sizes evenly."
msgstr "Εάν είναι αληθές, αναδιανέμει αυτόματα όλα τα μεγέθη στηλών ομοιόμορφα."

#: abilities/handlers/builder/class-uael-add-column-handler.php:121
msgid "section_id is required."
msgstr "Το section_id είναι υποχρεωτικό."

#. translators: 1: Section ID, 2: Post title, 3: Column ID
#: abilities/handlers/builder/class-uael-add-column-handler.php:148
msgid "Added column to section %1$s in \"%2$s\". Use builder/insert-widget with position {\"inside\": \"%3$s\"} to add widgets."
msgstr "Προστέθηκε στήλη στην ενότητα %1$s στο \"%2$s\". Χρησιμοποιήστε builder/insert-widget με θέση {\"inside\": \"%3$s\"} για να προσθέσετε widgets."

#: abilities/handlers/builder/class-uael-add-section-handler.php:47
msgid "Add Section/Container"
msgstr "Προσθήκη Ενότητας/Δοχείου"

#: abilities/handlers/builder/class-uael-add-section-handler.php:48
msgid "Adds a structural layout element to any Elementor post. On legacy sites: creates a section with columns. On container sites: creates a flex container with child containers. Supports inner sections and multi-column layouts."
msgstr "Προσθέτει ένα δομικό στοιχείο διάταξης σε οποιαδήποτε ανάρτηση Elementor. Σε παλαιές ιστοσελίδες: δημιουργεί μια ενότητα με στήλες. Σε ιστοσελίδες με δοχεία: δημιουργεί ένα δοχείο flex με παιδικά δοχεία. Υποστηρίζει εσωτερικές ενότητες και διατάξεις πολλαπλών στηλών."

#: abilities/handlers/builder/class-uael-add-section-handler.php:65
msgid "Array of column size percentages. Must sum to 100. E.g., [50, 50] for two equal columns, [33, 34, 33] for three columns, [25, 75] for sidebar layout."
msgstr "Πίνακας ποσοστών μεγέθους στηλών. Πρέπει να αθροίζεται σε 100. Π.χ., [50, 50] για δύο ίσες στήλες, [33, 34, 33] για τρεις στήλες, [25, 75] για διάταξη πλάγιου μενού."

#: abilities/handlers/builder/class-uael-add-section-handler.php:70
msgid "If true, creates an inner section (must be placed inside a column). On container sites, creates a nested container."
msgstr "Αν είναι αληθές, δημιουργεί μια εσωτερική ενότητα (πρέπει να τοποθετηθεί μέσα σε μια στήλη). Σε ιστοσελίδες με δοχεία, δημιουργεί ένα φωλιασμένο δοχείο."

#: abilities/handlers/builder/class-uael-add-section-handler.php:73
msgid "Where to insert: \"append\" (default), \"prepend\", { \"after\": \"element_id\" }, { \"before\": \"element_id\" }, { \"inside\": \"element_id\" } (for inner sections inside a column/container)."
msgstr "Πού να εισαχθεί: \"append\" (προεπιλογή), \"prepend\", { \"after\": \"element_id\" }, { \"before\": \"element_id\" }, { \"inside\": \"element_id\" } (για εσωτερικές ενότητες μέσα σε μια στήλη/δοχείο)."

#. translators: %d: total of column sizes
#: abilities/handlers/builder/class-uael-add-section-handler.php:135
msgid "Column sizes must sum to 100. Got %d."
msgstr "Τα μεγέθη των στηλών πρέπει να αθροίζονται σε 100. Λάβατε %d."

#: abilities/handlers/builder/class-uael-add-section-handler.php:184
msgid "inner section"
msgstr "εσωτερική ενότητα"

#: abilities/handlers/builder/class-uael-add-section-handler.php:185
msgid "container"
msgstr "δοχείο"

#: abilities/handlers/builder/class-uael-add-section-handler.php:185
msgid "section"
msgstr "ενότητα"

#. translators: 1: Element type, 2: Number of columns, 3: Post title
#: abilities/handlers/builder/class-uael-add-section-handler.php:194
msgid "Added %1$s with %2$d column(s) to \"%3$s\". Use column_ids to insert widgets into specific columns."
msgstr "Προστέθηκε %1$s με %2$d στήλη(ες) στην \"%3$s\". Χρησιμοποιήστε τα column_ids για να εισάγετε widgets σε συγκεκριμένες στήλες."

#: abilities/handlers/builder/class-uael-build-handler.php:48
msgid "Build Complete Layout"
msgstr "Δημιουργία Ολοκληρωμένης Διάταξης"

#: abilities/handlers/builder/class-uael-build-handler.php:49
msgid "Builds a complete layout with sections, columns, and widgets in one call. Replaces all content on the post. The structure parameter is a JSON string describing rows and widgets."
msgstr "Δημιουργεί μια ολοκληρωμένη διάταξη με ενότητες, στήλες και widgets σε μία κλήση. Αντικαθιστά όλο το περιεχόμενο στην ανάρτηση. Η παράμετρος δομής είναι μια συμβολοσειρά JSON που περιγράφει σειρές και widgets."

#: abilities/handlers/builder/class-uael-build-handler.php:125
msgid "structure is not valid JSON. It must be a minified JSON array string."
msgstr "Η δομή δεν είναι έγκυρο JSON. Πρέπει να είναι μια ελαχιστοποιημένη συμβολοσειρά JSON πίνακα."

#: abilities/handlers/builder/class-uael-build-handler.php:134
msgid "structure must be a JSON array of section objects. Example: [{\"columns\":[20,60,20],\"children\":[{\"type\":\"widget\",\"widget_type\":\"site-logo\",\"settings\":{}}]}]"
msgstr "Η δομή πρέπει να είναι ένας πίνακας JSON με αντικείμενα ενότητας. Παράδειγμα: [{\"columns\":[20,60,20],\"children\":[{\"type\":\"widget\",\"widget_type\":\"site-logo\",\"settings\":{}}]}]"

#: abilities/handlers/builder/class-uael-build-handler.php:144
msgid "Each item in structure must be a section object with \"children\". Example: {\"columns\":[20,60,20],\"children\":[{\"type\":\"widget\",\"widget_type\":\"site-logo\",\"settings\":{}}]}"
msgstr "Κάθε στοιχείο στη δομή πρέπει να είναι ένα αντικείμενο ενότητας με \"children\". Παράδειγμα: {\"columns\":[20,60,20],\"children\":[{\"type\":\"widget\",\"widget_type\":\"site-logo\",\"settings\":{}}]}"

#. translators: 1: Number of elements, 2: Post title
#: abilities/handlers/builder/class-uael-build-handler.php:177
msgid "Built \"%2$s\" with %1$d elements."
msgstr "Δημιουργήθηκε \"%2$s\" με %1$d στοιχεία."

#: abilities/handlers/builder/class-uael-css-handler.php:47
msgid "Regenerate CSS"
msgstr "Αναδημιουργία CSS"

#: abilities/handlers/builder/class-uael-css-handler.php:48
msgid "Forces Elementor to regenerate CSS files for a post so frontend changes appear immediately. Call after builder/build or any structural change."
msgstr "Επιβάλλει στο Elementor να αναδημιουργήσει τα αρχεία CSS για μια ανάρτηση ώστε οι αλλαγές στο frontend να εμφανίζονται άμεσα. Καλέστε μετά από builder/build ή οποιαδήποτε δομική αλλαγή."

#: abilities/handlers/builder/class-uael-css-handler.php:59
msgid "Any Elementor-enabled post ID. Pass 0 to regenerate all Elementor CSS globally."
msgstr "Οποιοδήποτε ID ανάρτησης ενεργοποιημένου Elementor. Περάστε 0 για να αναδημιουργήσετε όλα τα CSS του Elementor παγκοσμίως."

#: abilities/handlers/builder/class-uael-css-handler.php:109
msgid "You are not allowed to regenerate all Elementor CSS globally."
msgstr "Δεν έχετε δικαίωμα να αναδημιουργήσετε όλα τα CSS του Elementor παγκοσμίως."

#: abilities/handlers/builder/class-uael-css-handler.php:119
msgid "Regenerated all Elementor CSS files globally."
msgstr "Αναδημιουργήθηκαν όλα τα αρχεία CSS του Elementor παγκοσμίως."

#. translators: %s: Post title
#: abilities/handlers/builder/class-uael-css-handler.php:136
msgid "Regenerated CSS for \"%s\"."
msgstr "Αναδημιουργήθηκε το CSS για \"%s\"."

#: abilities/handlers/builder/class-uael-insert-widget-handler.php:47
msgid "Insert Widget"
msgstr "Εισαγωγή Widget"

#: abilities/handlers/builder/class-uael-insert-widget-handler.php:48
msgid "Inserts a single widget into an existing Elementor post. KEY WIDGET SLUGS — Core: heading, text-editor, image, button, spacer, divider. UAE Pro: uael-infobox (Info Box), uael-price-table (Price Box), uael-advanced-heading, uael-posts, uael-business-reviews. Use list-widget-types to discover all available slugs and get-schema for each widget's settings."
msgstr "Εισάγει ένα μόνο widget σε μια υπάρχουσα ανάρτηση Elementor. ΚΥΡΙΕΣ ΣΛΑΓΚ WIDGET — Βασικά: heading, text-editor, image, button, spacer, divider. UAE Pro: uael-infobox (Info Box), uael-price-table (Price Box), uael-advanced-heading, uael-posts, uael-business-reviews. Χρησιμοποιήστε το list-widget-types για να ανακαλύψετε όλα τα διαθέσιμα slugs και το get-schema για τις ρυθμίσεις κάθε widget."

#: abilities/handlers/builder/class-uael-insert-widget-handler.php:63
msgid "Widget type slug (e.g. \"navigation-menu\", \"site-logo\", \"heading\"). Use builder/list-widget-types to see available types."
msgstr "Σλάγκ τύπου widget (π.χ. \"navigation-menu\", \"site-logo\", \"heading\"). Χρησιμοποιήστε builder/list-widget-types για να δείτε τους διαθέσιμους τύπους."

#: abilities/handlers/builder/class-uael-insert-widget-handler.php:67
msgid "JSON string of widget settings. Use builder/get-schema to discover the keys. Example: {\"heading_title\":\"My Heading\",\"align\":\"center\"}. Pass empty string or \"{}\" for defaults."
msgstr "JSON string ρυθμίσεων widget. Χρησιμοποιήστε builder/get-schema για να ανακαλύψετε τα κλειδιά. Παράδειγμα: {\"heading_title\":\"My Heading\",\"align\":\"center\"}. Περάστε κενή συμβολοσειρά ή \"{}\" για προεπιλογές."

#: abilities/handlers/builder/class-uael-insert-widget-handler.php:71
msgid "Where to insert: \"append\" (default), \"prepend\", a number for index position (0=first, 1=second, etc.), or { \"after\": \"element_id\" }, { \"before\": \"element_id\" }, { \"inside\": \"container_id\" }."
msgstr "Πού να εισάγετε: \"append\" (προεπιλογή), \"prepend\", ένας αριθμός για τη θέση ευρετηρίου (0=πρώτος, 1=δεύτερος, κ.λπ.), ή { \"after\": \"element_id\" }, { \"before\": \"element_id\" }, { \"inside\": \"container_id\" }."

#: abilities/handlers/builder/class-uael-insert-widget-handler.php:117
msgid "Widget type is required."
msgstr "Ο τύπος widget είναι υποχρεωτικός."

#. translators: %s: Widget type slug
#: abilities/handlers/builder/class-uael-insert-widget-handler.php:138
msgid "Widget type \"%s\" is not recognized. Use builder/list-widget-types to see available types."
msgstr "Ο τύπος widget \"%s\" δεν αναγνωρίζεται. Χρησιμοποιήστε builder/list-widget-types για να δείτε τους διαθέσιμους τύπους."

#. translators: 1: Widget type, 2: Post title
#: abilities/handlers/builder/class-uael-insert-widget-handler.php:185
msgid "Inserted %1$s widget into \"%2$s\"."
msgstr "Εισήχθη το widget %1$s στο \"%2$s\"."

#: abilities/handlers/builder/class-uael-move-element-handler.php:48
msgid "Move Element"
msgstr "Μετακίνηση Στοιχείου"

#: abilities/handlers/builder/class-uael-move-element-handler.php:49
msgid "Repositions an element within any Elementor post. Removes from current location and inserts at new position."
