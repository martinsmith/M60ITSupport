msgstr "Aktivera sidvisningar"

#: modules/modal-popup/widgets/modal-popup.php:1628
msgid "Show popup only after visitor has viewed a specific number of pages."
msgstr "Visa popup endast efter att besökaren har sett ett visst antal sidor."

#: modules/modal-popup/widgets/modal-popup.php:1638
