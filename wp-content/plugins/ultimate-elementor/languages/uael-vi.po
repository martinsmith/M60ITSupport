msgstr "Chỉ hiển thị popup sau khi khách truy cập đã hoàn thành một số phiên trình duyệt cụ thể."

#: modules/modal-popup/widgets/modal-popup.php:1713
msgid "Show After X Sessions"
msgstr "Hiển thị Sau X Phiên"

#: modules/modal-popup/widgets/modal-popup.php:1722
msgid "The popup will show after the visitor completes the set number of browser sessions. A new session starts when they reopen your site in a new browser window."
msgstr "Popup sẽ hiển thị sau khi khách truy cập hoàn thành số phiên trình duyệt đã đặt. Một phiên mới bắt đầu khi họ mở lại trang web của bạn trong một cửa sổ trình duyệt mới."

